<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sauvegarde automatique Android désactivée (Drive comme transfert d'appareil) :
         aucune donnée ne quitte l'appareil, cf. res/xml/data_extraction_rules.xml. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Bouton « Cocher le rang » de la notification du rang en cours
             (RowNotificationPlugin). Visé par un intent explicite de l'app seule. -->
        <receiver
            android:name=".RowNotificationReceiver"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <!-- ⛔ PAS de permission INTERNET, délibérément (intent « vie privée », 06/09) :
         l'app est 100 % hors ligne — la webview charge des assets empaquetés, aucune
         donnée ne quitte l'appareil. Ne PAS la réajouter ; si une fusion de manifeste
         la ramène depuis une bibliothèque, la retirer par
         `<uses-permission android:name="android.permission.INTERNET" tools:node="remove"/>`
         et revérifier l'APK au aapt (`dump permissions`). -->

    <!-- Photos : appareil photo. La galerie passe par un <input type="file"> (sélecteur
         système, src/utils/photo.js), qui ne demande aucune permission de stockage/média —
         READ_MEDIA_IMAGES n'est PAS déclarée ici, ni requise par @capacitor/camera (vérifié
         dans son AndroidManifest.xml) ; Google Play l'avait signalée comme inutilisée,
         retirée le 17/09/2026. Ne pas la rajouter sans un usage réel qui la consomme. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Notification du rang en cours (spec 2026-09-29, RowNotificationPlugin) : permission
         d'exécution sur Android 13+, demandée une fois à la première ouverture du lecteur
         d'un projet, coupable dans les Réglages. Sans elle, rien n'est affiché. Ignorée
         sous Android 13. Aucune autre permission liée (pas d'alarme exacte, pas de
         démarrage au boot, pas de service de premier plan). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
