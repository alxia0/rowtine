<?xml version="1.0" encoding="utf-8"?>
<!-- Vue dépliée d'un compteur dans la notification du rang en cours : section, texte de
     l'étape et ligne « Ensuite » (bigText), puis le stepper de notif_counter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/notif_counter_section"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true" />

    <TextView
        android:id="@+id/notif_counter_text"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:ellipsize="end"
        android:maxLines="6" />

    <include layout="@layout/notif_counter" />
</LinearLayout>
